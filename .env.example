# Optional: API base URL. Leave empty to use same-origin (e.g. Next.js API routes).
# NEXT_PUBLIC_APP_API=
# NEXT_PUBLIC_APP_ENV=development

# Portfolio static “database”: config/ (projects.manifest.yaml + projects/<slug>/).
# Default: ./config when cwd is this repo root. Override for custom layouts.
# PORTFOLIO_CONFIG_ROOT=/absolute/path/to/config

# Internal portfolio comments → Slack (server only). Uncomment code in
# src/lib/portfolio/slack-comment-notify.ts when ready.
# SLACK_WEBHOOK_URL_PORTFOLIO_COMMENTS=https://hooks.slack.com/services/...

# Mock login (MVP). Used by POST /api/auth/login — must match sign-in form.
NEXT_PUBLIC_MOCK_EMAIL=user@gmail.com
NEXT_PUBLIC_MOCK_PASSWORD=123456

